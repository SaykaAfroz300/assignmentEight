# ─── StudioSpace client environment ───
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# BetterAuth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas (use the SAME values as the Express server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Express API base URL (the Next.js /server-api proxy forwards to it)
API_URL=http://localhost:5000

# Google OAuth (optional) - redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
