PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (shared with BetterAuth in studiospace-client)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Secret used to sign the HTTPOnly JWT cookie (Challenge 1)
JWT_SECRET=Fovuc9hvBP25WOg49qQSaDv7p0BBZZhOrzhlmtjIMCNMSkpZoJhWLbCrasIRAMmb
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins (Next.js client)
CLIENT_ORIGINS=http://localhost:3000

# Optional Google OAuth credentials (if using Google Cloud Console OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
